# Copy this file to .env.local after creating your Supabase project.
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co

# Project Settings > API Keys. Newer Supabase projects issue a "publishable" key (sb_publishable_...);
# older projects show a legacy "anon" key instead. Either name works — set whichever your dashboard gave you.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=YOUR_SUPABASE_PUBLISHABLE_KEY
# NEXT_PUBLIC_SUPABASE_ANON_KEY=YOUR_SUPABASE_ANON_KEY

# Server-only. Never expose this value in browser code or commit it to Git.
SUPABASE_SERVICE_ROLE_KEY=YOUR_SUPABASE_SERVICE_ROLE_KEY

# Public address of the app. Use http://localhost:3000 during local development.
NEXT_PUBLIC_APP_URL=http://localhost:3000


